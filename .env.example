# Copy this file to .env and fill it in. .env stays out of git.

# Your test keys: Dashboard > Settings > API keys. The publishable key goes to the browser, the secret key never does.
FLUVEO_PUBLISHABLE_KEY=
FLUVEO_SECRET_KEY=

# The signing secret of your webhook endpoint (whsec_...). Empty until you create an endpoint: npm run verify then
# signs its test event with a secret of its own.
FLUVEO_WEBHOOK_SECRET=

# Leave these empty for the test sandbox, https://api.stagfluveo.com and https://js.stagfluveo.com. Fill them only to
# use another Fluveo environment: each is an origin, with no path.
FLUVEO_API_BASE=
FLUVEO_JS_ORIGIN=

# The port npm start listens on. Empty is 4242.
PORT=
